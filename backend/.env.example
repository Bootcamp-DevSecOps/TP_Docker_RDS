# Copier ce fichier en ".env" pour un test en local (NE PAS committer le .env reel)
# En production, ces variables doivent etre injectees via docker-compose.yml / secrets

PORT=3000

# Connexion a la base de donnees (RDS en production)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=taskmanager
PGSSL=false
